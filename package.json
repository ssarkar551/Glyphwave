{
	"name": "glyphwave",
	"private": false,
	"license": "MIT",
	"version": "0.4.6",
	"files": [
		"dist",
		"index.d.ts"
	],
	"types": "index.d.ts",
	"type": "module",
	"main": "dist/emoji-icon-lib.cjs",
	"module": "dist/emoji-icon-lib.es.js",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./dist/emoji-icon-lib.es.js",
			"require": "./dist/emoji-icon-lib.cjs"
		}
	},
	"scripts": {
		"build": "vite build",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "node scripts/component-test.mjs",
		"test:smoke": "node scripts/smoke-test.mjs",
		"pack:check": "node scripts/pack-check.mjs",
		"tree-shake:check": "node scripts/tree-shake-check.mjs",
		"check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:smoke && npm run pack:check && npm run tree-shake:check"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"eslint": "^9.30.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"vite": "^7.0.4"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	}
}
